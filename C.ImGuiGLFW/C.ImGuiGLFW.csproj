<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	<TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <Authors>C</Authors>
    <OutputType>Library</OutputType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>imgui;oepngl;glfw</PackageTags>
    <Description>C# class library that simplifies the creation of ImGui-rendered windows.</Description>
    <Copyright>MIT</Copyright>
    <Platform>AnyCPU</Platform>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <GenerateAssemblyInfo>True</GenerateAssemblyInfo>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <GenerateAssemblyInfo>True</GenerateAssemblyInfo>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="assets\NotoEmoji-Regular.ttf" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="assets\FontAwesomeFreeSolid.otf" />
    <EmbeddedResource Include="assets\NotoEmoji-Regular.ttf" />
    <EmbeddedResource Include="assets\NotoSansJP-Medium.ttf" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\README.md" Link="README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
	<None Include="..\THIRD-PARTY-NOTICES.txt" Link="THIRD-PARTY-NOTICES.txt">
	  <Pack>True</Pack>
	  <PackagePath>\</PackagePath>
	</None>
	<None Include="..\LICENSE.md" Link="LICENSE.md">
	  <Pack>True</Pack>
	  <PackagePath>\</PackagePath>
	</None>
  </ItemGroup>
	
  <PropertyGroup>
	<PackageLicenseFile>LICENSE.md</PackageLicenseFile>
	<Version>2.0.0.31</Version>
	<AssemblyVersion></AssemblyVersion>
	<FileVersion></FileVersion>
	<GenerateDocumentationFile>True</GenerateDocumentationFile>
	<Deterministic>false</Deterministic>
  </PropertyGroup>
	
  <ItemGroup>
    <PackageReference Include="Hexa.NET.GLFW" Version="1.0.5" />
    <PackageReference Include="Hexa.NET.ImGui" Version="3.1.0-experimental" />
    <PackageReference Include="Hexa.NET.ImGui.Backends" Version="3.1.0-experimental" />
    <PackageReference Include="Hexa.NET.ImGui.Backends.GLFW" Version="3.1.0-experimental" />
    <PackageReference Include="Hexa.NET.ImGui.Widgets" Version="1.2.18" />
    <PackageReference Include="Hexa.NET.ImGui.Widgets.Extras" Version="1.0.9" />
    <PackageReference Include="Hexa.NET.ImGuizmo" Version="3.1.0-experimental" />
    <PackageReference Include="Hexa.NET.ImNodes" Version="3.1.0-experimental" />
    <PackageReference Include="Hexa.NET.ImPlot" Version="3.1.0-experimental" />
    <PackageReference Include="Hexa.NET.ImPlot3D" Version="3.1.0-experimental" />
    <PackageReference Include="Hexa.NET.OpenGL.Core" Version="1.1.0" />
    <PackageReference Include="Hexa.NET.OpenGL4" Version="1.1.0" />
    <PackageReference Include="Hexa.NET.Utilities" Version="2.2.12" />
    <PackageReference Include="ImAnim.NET" Version="1.0.0" />
    <PackageReference Include="MaterialColorUtilities" Version="0.3.0" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
  </ItemGroup>
</Project>
